#!/bin/sh
# The test of the memory server's cleaning of the checkpoint log (#952),
# under QEMU.
#
#   scripts/test-log-clean [ISO]
#
# ISO is the install image, images/rose.iso by default. A test disk's log
# is about half of the disk, which an idle system would take days to fill,
# so the test makes it smaller:
#
#   1. installs Rose on a new disk;
#   2. shrinks the log partition with set-log-size.py so that the install's
#      entries fill FILL percent of it, past the level at which mem starts
#      cleaning (Rose.Limits.Clean_Start_Percent), with room for cleaning
#      to copy into.  The room is in proportion to the install, since what
#      a boot writes grows with it: hold_pages (#975) writes a quarter of
#      its 48 MiB again after each restore;
#   3. boots from the disk, at most ROUNDS times, each of which has to
#      restore the checkpoint that check-log.py says, with the shared pages
#      it says, and show the login prompt, leaves the system idle for
#      MINUTES minutes, and stops the machine wherever it is; then runs
#      check-log.py, which has to find the log consistent.  The log must
#      never fill up, which it can't recover from (#1029).  The boots stop
#      once the log has both wrapped around and been cleaned.
#
# At the end, the log has to start after location 1, which only cleaning
# makes happen, and to have wrapped around: the system wrote more than the
# log would have held without cleaning, and restored each time.
#
# It takes about an hour, and needs qemu-system-i386, qemu-img and python3.
# It exits with 0 if everything passed, and keeps the disk image and QEMU's
# files if anything failed.

ISO=${1:-images/rose.iso}
HERE=$(cd "$(dirname "$0")" && pwd)
FILL=${FILL:-60}
ROUNDS=${ROUNDS:-12}
MINUTES=${MINUTES:-4}

command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

check_log () {
    # check_log WHEN: run check-log.py on the disk, and fail if it finds
    # the log inconsistent
    python3 "$HERE/check-log.py" "$DISK" > "$WORK/check-log.txt" 2>&1 \
        || { cat "$WORK/check-log.txt"; fail "check-log.py: $1"; }
    grep -E "^log|entries|wrapped|full|restore reads" "$WORK/check-log.txt" \
        | tail -4
}

install_rose "$ISO"

check_log "after the install"
used=$(sed -n 's/^.*next entry at location \([0-9]*\).*$/\1/p' \
           "$WORK/check-log.txt")
[ -n "$used" ] || fail "check-log.py did not say where the next entry goes"

size=$((used * 100 / FILL))
echo "Shrinking the log to $size pages, which the install's $used fill" \
     "$FILL percent of"
python3 "$HERE/set-log-size.py" "$DISK" $size \
    || fail "set-log-size.py could not shrink the log"

cleaned () {
    # cleaned: true if the last check_log found the log both wrapped
    # around and started after location 1
    start=$(sed -n 's/^log starts at location \([0-9]*\),.*/\1/p' \
                "$WORK/check-log.txt")
    [ -n "$start" ] && [ "$start" -gt 1 ] \
        && grep -q "the log has wrapped around" "$WORK/check-log.txt"
}

round=1
while [ $round -le $ROUNDS ] && ! cleaned; do
    echo "Boot $round from the disk, which restores the last checkpoint"
    # Restore has to choose the entry that check-log.py says, and load
    # the shared pages it says, from entries on both sides of the wrap
    # once the log has wrapped around (#953).
    checkpoint=$(sed -n 's/^restore reads the entry at \([0-9]*\).*/\1/p' \
                     "$WORK/check-log.txt")
    shared=$(sed -n 's/^restore reads .*loads \([0-9]*\) shared.*/\1/p' \
                 "$WORK/check-log.txt")
    # QEMU may start CONSOLE again, so the mark is taken once it has.
    start_qemu
    mark=$(console_mark)
    choose_last_entry
    wait_for "login:" 300 || fail "boot $round: no login prompt"
    console_since "$mark" > "$WORK/boot.txt"
    grep -q "restore: restored processes are running" "$WORK/boot.txt" \
        || fail "boot $round: the checkpoint was not restored"
    grep -q -E "restore: log: checkpoint at $checkpoint([^0-9]|\$)" \
         "$WORK/boot.txt" \
        || { grep "restore: log:" "$WORK/boot.txt"
             fail "boot $round: restore did not choose $checkpoint"; }
    grep -q "shared pages: $shared;" "$WORK/boot.txt" \
        || { grep "restore: processes" "$WORK/boot.txt"
             fail "boot $round: restore did not load $shared shared pages"; }

    echo "Leaving it idle for $MINUTES minutes, then stopping it"
    sleep $((MINUTES * 60))
    console_since "$mark" > "$WORK/boot.txt"
    grep -E "log: .*(full|not committed|freed)" "$WORK/boot.txt" | head -3
    stop_qemu
    ! grep -q "log: log is full" "$WORK/boot.txt" \
        || fail "boot $round: the log filled up, which it can't recover" \
                "from (#1029)"
    check_log "after boot $round"
    round=$((round + 1))
done

start=$(sed -n 's/^log starts at location \([0-9]*\),.*/\1/p' \
            "$WORK/check-log.txt")
[ -n "$start" ] && [ "$start" -gt 1 ] \
    || fail "the log still starts at location 1: nothing was freed"
grep -q "the log has wrapped around" "$WORK/check-log.txt" \
    || fail "the log did not wrap around"

echo "PASS: the log was cleaned and wrapped around, and every boot restored"
rm -rf "$WORK"
exit 0
