#!/bin/sh
# The update test (#830, ADR 0031 section 6): this build's install media
# has to update a disk that the release where its series froze installed,
# keeping its checkpoint, and replace its replaceable servers.
#
#   scripts/test-update-fixture [FIXTURE [ISO]]
#
# FIXTURE is a disk that make-restore-fixture wrote, and ISO this build's
# install image, images/rose.iso by default. Without FIXTURE, the test
# uses the fixture of this build's release series X.Y, as
# test-restore-fixture does, and passes with a note if there is none yet.
#
# The test:
#
#   1. boots the install media with a copy of the fixture as hd0, and
#      chooses "Update Rose on hd0", which restores hd0's checkpoint with
#      this boot set, writes the set to hd0, installs the commands again
#      (#829), replaces each restored Replaceable server (#830), and
#      restarts. Its console has to say that the commands were installed
#      again, that each kind of replaceable server in the fixture (file,
#      directory, user and auth) was replaced, with none left unchanged,
#      and that the update is complete, and the kernel's log has to show
#      a new version of each kind taking over (#922);
#   2. boots the new set from hd0, its serial-console entry, which comes
#      before "Previous". Login is still reading the name it was reading
#      when the fixture was made, so an empty line brings its prompt
#      back. Then it logs in, and reads the file that
#      make-restore-fixture left, notes, which a replaced file serves;
#   3. boots "Previous", the set that hd0 had before. If this build has
#      the fixture's interface level, Previous has to restore the
#      checkpoint that step 2 left, with petal on the screen. If this
#      build added interfaces, that checkpoint has a level the previous
#      set doesn't have, and Previous has to refuse it (ADR 0031,
#      section 3);
#   4. runs check-log.py on the disk, which has to find the log
#      consistent.
#
# A fixture made from this build is enough to test the update while
# the frozen release isn't out: the update replaces every replaceable server,
# whether or not its program changed. Checking that a server reports the
# new version needs a fixture from an earlier release.
#
# It takes about fifteen minutes, and needs qemu-system-i386, qemu-img and
# python3. It exits with 0 if everything passed, and keeps the disk image
# and QEMU's files if anything failed.

HERE=$(cd "$(dirname "$0")" && pwd)
ISO=${2:-$HERE/../images/rose.iso}

if [ $# -ge 1 ]; then
    FIXTURE=$1
else
    VERSION=$(sed -n \
        's/.*Version_String *: constant String := "\(.*\)";/\1/p' \
        "$HERE/../src/base/rose-version.ads")
    SERIES=$(echo "$VERSION" | sed -n 's/^\([0-9]*\.[0-9]*\)\..*/\1/p')
    [ -n "$SERIES" ] || {
        echo "no release series in the version, $VERSION"
        exit 2
    }
    FROZEN=$(sh "$HERE/frozen-release" "$SERIES") || exit 2
    NAME=rose-$FROZEN-hd0.qcow2
    FIXTURE=$HERE/../images/fixtures/$NAME
    if [ ! -f "$FIXTURE" ]; then
        URL=https://github.com/blancolioni/rose/releases/download/v$FROZEN/$NAME
        mkdir -p "$(dirname "$FIXTURE")" || exit 2
        if curl -fsL -o "$FIXTURE.part" "$URL"; then
            mv -f "$FIXTURE.part" "$FIXTURE"
        else
            rm -f "$FIXTURE.part"
            echo "No $FROZEN fixture yet ($URL); nothing to update"
            exit 0
        fi
    fi
fi

[ -f "$FIXTURE" ] || { echo "no fixture: $FIXTURE"; exit 2; }
[ -f "$ISO" ] || { echo "no install image: $ISO"; exit 2; }
command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

qemu-img convert -O raw "$FIXTURE" "$DISK" || fail "could not copy the fixture"

# The interface level of the fixture's last checkpoint, and this build's
# (ADR 0031, section 2). A checkpoint that the new set writes has this
# build's level, and the previous set restores it only if the two match.
FIXTURE_LEVEL=$(python3 "$HERE/check-log.py" "$DISK" \
    | sed -n 's/.*interfaces [0-9]*\.[0-9]* level \([0-9]*\).*/\1/p' \
    | tail -1)
BUILD_LEVEL=$(sed -n 's/^ *Level *: constant := \([0-9]*\);.*/\1/p' \
    "$HERE/../build/version/rose-interface_level.ads")
[ -n "$FIXTURE_LEVEL" ] || fail "no interface level in the fixture's log"
[ -n "$BUILD_LEVEL" ] || fail "no interface level in this build"

echo "Updating $(basename "$FIXTURE") from the install media"
start_qemu -boot d -drive file="$ISO",if=ide,index=1,media=cdrom
# The menu's first entry boots hd0, and the next two update it: with
# the framebuffer, and in text mode with the serial console, which the
# fixture was installed with.
choose_entry 2
wait_for_serial "kernel: restarting" 900 || fail "the update did not finish"
stop_qemu

grep -e "restore:" -e "update complete" "$CONSOLE"
grep -q "restore: installing the commands again" "$CONSOLE" \
    || { echo "FAIL: the update did not install the commands again"; exit 1; }
grep -q "is unchanged:" "$CONSOLE" \
    && { echo "FAIL: a replaceable server was not replaced"; exit 1; }
grep -q "update complete" "$CONSOLE" \
    || { echo "FAIL: the update did not complete"; exit 1; }
# The fixture has each kind of replaceable server: the files and
# directories of the user's home, the first user's server and hold_home's,
# and auth (#922).
for server in file directory user auth; do
    grep -q "restore: replaced $server" "$CONSOLE" \
        || { echo "FAIL: the update replaced no $server"; exit 1; }
    grep -a "/$server\[.*takes over from" "$WORK/serial" \
        || { echo "FAIL: no $server took over in the kernel's log"; exit 1; }
done

echo "Booting the new set from hd0"
start_qemu
# "Previous" is the last entry now, and the new set's serial-console
# entry is the one before it.
choose_entry_from_bottom 1
wait_for_console "caps: restored" 200 \
    || fail "the new set did not restore the checkpoint"
# Login is transient, so supervisor has started a new one, and what the
# update wrote to the console may have scrolled its prompt away: an
# empty name brings the prompt back. The old login's deferred read is
# forgotten when the console is told it was restored (#1114).
type_text "
"
log_in
mark=$(console_mark)
type_text "cat notes
"
wait_for_console "hello from kilo" 30 "$mark" \
    || fail "the file that the fixture's user left is gone"
echo "notes is still there"
echo "Waiting for a checkpoint, then stopping the machine"
sleep 45
stop_qemu

echo "Booting Previous, the set hd0 had before the update"
start_qemu
choose_last_entry
# Previous shows the old set's own menu.
choose_last_entry
if [ "$BUILD_LEVEL" -eq "$FIXTURE_LEVEL" ]; then
    # The checkpoint is the new set's, with petal at its prompt after
    # cat.
    wait_for "hello from kilo" 200 \
        || fail "Previous did not restore the checkpoint"
else
    # This build added interfaces, so the previous set can't read the
    # new set's checkpoint, and leaves it alone (ADR 0031, section 3).
    wait_for "can't read the checkpoint on hd0" 200 \
        || fail "Previous did not refuse a checkpoint at level $BUILD_LEVEL"
    echo "Previous refused the checkpoint: its level is $FIXTURE_LEVEL," \
        "and this build's is $BUILD_LEVEL"
fi
stop_qemu

echo "Checking the log"
python3 "$HERE/check-log.py" "$DISK" > "$WORK/check-log.txt" || {
    cat "$WORK/check-log.txt"
    echo "FAIL: the log is not consistent; the disk image is in $WORK"
    exit 1
}

rm -rf "$WORK"
echo "PASS"
