#!/bin/sh
# Write Rose.Build, the build id that the boot banners show after the
# version: "Rose Version 0.4.0-dev (genki) [d87c2c8]".  The id is the
# commit the build is from, with "-dirty" if the tree had uncommitted
# changes, so that a screenshot or a bug report says which build it came
# from.  A release built at its own tag (v<Version_String>) with no
# changes has no id, and so has a build with no git.  Run it from the top
# of the tree.  The file is only rewritten when it changes, so that an
# unchanged build doesn't recompile the units that use it.

OUT=build/version/rose-build.ads
VERSION=$(sed -n 's/.*Version_String *: constant String := "\(.*\)";/\1/p' \
    src/base/rose-version.ads)

ID=""
if HEAD=$(git rev-parse --short=7 HEAD 2>/dev/null)
then
    if [ -n "$(git status --porcelain --untracked-files=no 2>/dev/null)" ]
    then
        ID="$HEAD-dirty"
    elif [ "$(git describe --tags --exact-match 2>/dev/null)" != "v$VERSION" ]
    then
        ID="$HEAD"
    fi
fi

if [ -n "$ID" ]
then
    SUFFIX=" [$ID]"
else
    SUFFIX=""
fi

mkdir -p build/version
cat > $OUT.new <<END
--  Generated by scripts/make-build-id: do not edit.

with Rose.Version;

package Rose.Build is

   pragma Pure (Rose.Build);

   Build_Id     : constant String := "$ID";
   --  The commit this build is from, with -dirty if the tree had
   --  uncommitted changes.  Empty for a release built at its tag.

   Build_Suffix : constant String := "$SUFFIX";
   --  The build id in brackets, after a space, or empty.

   Full_Name    : constant String := Rose.Version.Full_Name & Build_Suffix;

end Rose.Build;
END

if cmp -s $OUT.new $OUT
then
    rm $OUT.new
else
    mv $OUT.new $OUT
fi
