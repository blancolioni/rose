#!/bin/sh
# Boot test of the screen driver (#582), under QEMU, with a framebuffer.
#
#   scripts/test-screen [ISO]
#
# ISO is the install image, images/rose.iso by default. The test:
#
#   1. installs Rose on a new disk from the install menu's framebuffer
#      entry, so that init installs the screen driver and gives its
#      surface to the self tests, whose screen test draws a pattern on it
#      (Tests.Screen); a screen dump during the install has to show it;
#   2. boots from the disk's framebuffer entry, which restores the
#      install's checkpoint, and the screen driver redraws the screen from
#      its buffer: a screen dump has to show the pattern again;
#   3. waits for a checkpoint, stops the machine, and runs check-log.py on
#      the disk.
#
# The console stays on the VGA text page, which isn't on the screen in
# framebuffer mode, so the test can't log in or read what is written.
# It takes about ten minutes, and needs qemu-system-i386, qemu-img and
# python3. It exits with 0 if everything passed, and keeps the disk image
# and QEMU's files if anything failed.

ISO=${1:-images/rose.iso}
HERE=$(cd "$(dirname "$0")" && pwd)

command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

monitor () {
    # monitor COMMAND: send COMMAND to QEMU's monitor
    python3 - "$MONITOR" "$1" <<'EOF'
import socket, sys, time
c = socket.socket(socket.AF_UNIX)
c.connect(sys.argv[1])
c.sendall((sys.argv[2] + "\n").encode())
time.sleep(0.3)
EOF
}

choose_last_entry () {
    # Choose the last entry of the GRUB menu. End is pressed for twelve
    # seconds, which is long enough for the menu to appear and stop its
    # countdown, and does nothing more however often it is pressed.
    i=0
    while [ $i -lt 24 ]; do
        monitor "sendkey end"
        sleep 0.5
        i=$((i + 1))
    done
    monitor "sendkey ret"
}

shows_pattern () {
    # shows_pattern NAME: dump the screen to NAME.ppm, and check it
    monitor "screendump $WORK/$1.ppm"
    sleep 2
    python3 "$HERE/check-screen.py" "$WORK/$1.ppm"
}

[ -f "$ISO" ] || { echo "no install image: $ISO"; exit 2; }
qemu-img create -f raw "$DISK" 6G > /dev/null

echo "Installing, with a framebuffer"
start_qemu -boot d -drive file="$ISO",if=ide,index=1,media=cdrom
choose_last_entry

# The install restarts the machine when it has finished. Until then, dump
# the screen every ten seconds, and look for the pattern.
seen=""
waited=0
while [ $waited -lt 900 ]; do
    grep -q -- "kernel: restarting" "$WORK/serial" 2> /dev/null && break
    if [ -z "$seen" ] && shows_pattern install > "$WORK/install.txt"; then
        seen=yes
        cat "$WORK/install.txt"
    fi
    sleep 8
    waited=$((waited + 10))
done
grep -q -- "kernel: restarting" "$WORK/serial" \
    || fail "the install did not finish"
[ -n "$seen" ] || fail "the install never showed the screen test's pattern"
sleep 15
stop_qemu

echo "Booting from the disk's framebuffer entry, which restores the install"
start_qemu
choose_last_entry
wait_for_serial "derivation records restored" 200 \
    || fail "the checkpoint was not restored"
sleep 30
shows_pattern restored \
    || fail "the restored screen driver did not redraw the screen"

echo "Waiting for a checkpoint, then stopping the machine"
sleep 45
stop_qemu

echo "Checking the log"
python3 "$HERE/check-log.py" "$DISK" || {
    echo "FAIL: the log is not consistent; the disk image is in $WORK"
    exit 1
}

rm -rf "$WORK"
echo "PASS"
