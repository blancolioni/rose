#!/bin/sh
# Boot test of the console on the screen (#582, #653), under QEMU, with a
# framebuffer.
#
#   scripts/test-screen [ISO]
#
# ISO is the install image, images/rose.iso by default. The test:
#
#   1. installs Rose on a new disk from the install menu's framebuffer
#      test install, the third entry with no Rose on the disk (#1088), so
#      that the screen driver holds the framebuffer and the keyboard, and
#      the console is surface-console on its surface; the install's self
#      tests, which init runs, have to pass, as the console
#      shows; and the console has to show the boot's early messages, which
#      the boot console wrote to the serial port and replays to it (#654);
#   2. boots from the disk's first entry, which restores the
#      install's checkpoint, logs in as the first user, and runs
#      run_self_tests, which has to pass every test: the keys go through
#      the screen driver and the surface's events to the console, and the
#      text comes back drawn on the surface; then runs keytest, which has
#      to draw in the corners of the framebuffer's larger screen and move
#      its mark with the arrow keys (#734); then moves the mouse, clicks
#      and turns the wheel, through QEMU's monitor, and checks the
#      pointer's events, which the console writes to COM2 with
#      pointer-trace on the kernel's command line: so the mouse works
#      after a restore, which sets it up again (#588);
#   3. waits for a checkpoint, stops the machine, and runs check-log.py on
#      the disk.
#
# The screen's text is read from QEMU's screen dumps by fb-text.py. It
# takes about ten minutes, and needs qemu-system-i386, qemu-img and
# python3. It exits with 0 if everything passed, and keeps the disk image
# and QEMU's files if anything failed.

ISO=${1:-images/rose.iso}
HERE=$(cd "$(dirname "$0")" && pwd)

command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

screen () {
    # The text on the framebuffer, in place of the VGA text page that
    # qemu-test-lib.sh reads.
    python3 "$HERE/fb-text.py" "$MONITOR"
}

boot_with () {
    # boot_with ARGUMENT: boot the first entry of the disk's GRUB menu with
    # ARGUMENT added to the kernel's command line. Home is pressed for
    # twelve seconds, as choose_entry does; then e edits the entry. GRUB
    # shows the entry with a setparams line and a blank line first, so
    # Down twice goes to the multiboot2 command, End goes to the end of
    # it, and Ctrl-X boots.
    i=0
    while [ $i -lt 24 ]; do
        monitor "sendkey home"
        sleep 0.5
        i=$((i + 1))
    done
    monitor "sendkey e"
    sleep 2
    monitor "sendkey down"
    monitor "sendkey down"
    monitor "sendkey end"
    type_text " $1"
    sleep 1
    monitor "sendkey ctrl-x"
}

pointer () {
    # pointer EXPECTED WHAT COMMAND...: run COMMAND, and wait for the line
    # EXPECTED in the console's trace
    expected=$1
    what=$2
    shift 2
    mark=$(console_mark)
    "$@"
    wait_for_console "^$expected\$" 30 "$mark" \
        || fail "$what: expected '$expected'"
    echo "$what: $expected"
}

move_far () {
    # move_far DX DY: move the mouse twelve times by DX and DY. QEMU sends
    # a large movement in parts, and keeps the rest until the mouse's next
    # event, so a far move is made of small ones that it sends whole.
    i=0
    while [ $i -lt 12 ]; do
        monitor "mouse_move $1 $2"
        i=$((i + 1))
    done
}

passed () {
    # passed LINE: LINE is a self test result with every test passed
    set -- $(echo "$1" \
        | sed -n 's/.*tests \([0-9][0-9]*\); passed \([0-9][0-9]*\);.*/\1 \2/p')
    [ $# -eq 2 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ]
}

[ -f "$ISO" ] || { echo "no install image: $ISO"; exit 2; }
qemu-img create -f raw "$DISK" 6G > /dev/null

echo "Installing, with a framebuffer"
start_qemu -boot d -drive file="$ISO",if=ide,index=1,media=cdrom
# The test install that keeps the framebuffer: after the first install
# entry and the erasing one, since the new disk has no Rose (#1088).
choose_entry 2

# The install restarts the machine when it has finished. Until then, read
# the screen every two seconds or so, and keep the self tests' result. The
# result is on the screen for only a few seconds before the restart, since
# the console scrolls quickly (#787). Restore installs ps2 before
# surface-console, so its line is on the screen only if the boot console
# replayed it.
: > "$WORK/install-results.txt"
early=
waited=0
answered=
while [ $waited -lt 900 ]; do
    grep -q -- "kernel: restarting" "$WORK/serial" 2> /dev/null && break
    screen > "$WORK/screen.txt"
    answer_install "$WORK/screen.txt"
    grep "Test result:" "$WORK/screen.txt" >> "$WORK/install-results.txt"
    grep -q "installing: ps2: done" "$WORK/screen.txt" && early=yes
    sleep 1
    waited=$((waited + 2))
done
grep -q -- "kernel: restarting" "$WORK/serial" \
    || fail "the install did not finish"
[ -n "$early" ] || fail "the console never showed the early messages"
result=$(sort -u "$WORK/install-results.txt" | tail -1)
[ -n "$result" ] || fail "the console never showed the install's self tests"
echo "install: $result"
passed "$result" || fail "not every install self test passed"
sleep 15
stop_qemu

echo "Booting from the disk, which restores the install"
start_qemu
boot_with pointer-trace
log_in

# With a framebuffer, the boot console writes to the serial port, so the
# storage server's restore of its banks is there (#518): the root bank and
# the screen driver's at least, and none lost.
banks=$(grep -h "storage: restore: banks:" "$WORK/serial" | tail -1)
echo "$banks"
count=$(echo "$banks" | sed -n 's/.*banks: *\([0-9][0-9]*\).*/\1/p')
[ -n "$count" ] && [ "$count" -ge 2 ] \
    || fail "the storage server did not restore the banks"
grep -h "storage: restore: .*was not restored" "$WORK/serial" \
    && fail "the storage server lost a bank or a region's bank"

echo "Running the self tests"
type_text "clear
"
sleep 5
type_text "run_self_tests
"
wait_for "Test result:" 120 || fail "the self tests did not finish"
result=$(screen | grep "Test result:" | tail -1)
echo "$result"
passed "$result" || fail "not every self test passed"

echo "Running keytest on the framebuffer's screen"
check_keytest

# The mouse, through QEMU's monitor (#588). QEMU sends the PS/2 mouse a
# relative movement, with Y positive down; a wheel turn away from the
# user is dz 1. The screen is 1024 by 768, and the pointer stays on it.
echo "Moving the mouse"
pointer "pointer: 0 0 0" "the top left" move_far -100 -100
pointer "pointer: 10 20 0" "a move" monitor "mouse_move 10 20"
pointer "pointer: 10 20 1" "the left button down" monitor "mouse_button 1"
pointer "pointer: 10 20 0" "the left button up" monitor "mouse_button 0"
pointer "pointer: 10 20 2" "the right button down" monitor "mouse_button 2"
pointer "pointer: 10 20 0" "the right button up" monitor "mouse_button 0"
pointer "pointer: 1023 767 0" "the bottom right" move_far 100 100
pointer "wheel: -1" "the wheel away" monitor "mouse_move 0 0 1"
pointer "wheel: 1" "the wheel towards" monitor "mouse_move 0 0 -1"

echo "Typing while the mouse moves"
type_text "echo ty"
monitor "mouse_move -5 -5"
type_text "ped
"
wait_for "^typed" 20 || fail "the keys were lost while the mouse moved"

echo "Waiting for a checkpoint, then stopping the machine"
sleep 45
stop_qemu

echo "Checking the log"
python3 "$HERE/check-log.py" "$DISK" || {
    echo "FAIL: the log is not consistent; the disk image is in $WORK"
    exit 1
}

rm -rf "$WORK"
echo "PASS"
