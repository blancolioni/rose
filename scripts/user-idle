#!/bin/sh
# user-idle IDLE ROOT [OPTION...] FILE...
#
# Runs idle for a userland program, from the program's directory: the
# user target, Rose's interfaces on the search path, into build/generated,
# with any other options and the files given. Then it deletes from
# build/generated the units that the userland RTS provides through
# rts/user/rose_rts.gpr: a unit can belong to only one project (#1080).
#
# mk/common.mk names it USER_IDLE, with IDLE and ROOT filled in.

idle=$1
root=$2
shift 2

units=$root/rts/user/build/rose-units.lst
if [ ! -f "$units" ]; then
    echo "user-idle: no $units: build the userland RTS first (make rts)" >&2
    exit 1
fi

mkdir -p build/generated || exit 1
$idle --target user -I "$root/interfaces" -o build/generated "$@" || exit 1
(cd build/generated && xargs rm -f < "$units")
