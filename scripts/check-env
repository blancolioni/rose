#!/bin/sh
# Check that what the build needs is installed, and say everything that
# isn't, so that it doesn't fail halfway through.  Run from the top of the
# tree, by clean-build.sh and "make check-env".

. ./scripts/build-env.sh

GCC_VERSION=15
failed=no

problem () {
    echo "check-env: $*" >&2
    failed=yes
}

# need COMMAND [WHERE]: WHERE says what provides it
need () {
    command -v "$1" >/dev/null 2>&1 || problem "$1 not found${2:+ ($2)}"
}

need make
need gcc
need gnatmake "GNAT"
need gprbuild "GNAT"
need objdump binutils
need readelf binutils
need strip binutils
need truncate coreutils
need qemu-img qemu-img
need mformat mtools
need mmd mtools
need mcopy mtools
need xorriso xorriso
need "$IDLE" "idle; see the README, or set IDLE"
need "$GRUB_MKRESCUE" "grub2-tools-extra; or set GRUB_MKRESCUE"
need "$GRUB_MKIMAGE" "grub2-tools; or set GRUB_MKIMAGE"

[ -f "$GRUB_DIR/boot.img" ] ||
    problem "no $GRUB_DIR/boot.img (grub2-pc-modules; or set GRUB_DIR)"
[ -f "$GRUB_FONT" ] ||
    problem "no $GRUB_FONT (grub2-tools; or set GRUB_FONT)"

if command -v gcc >/dev/null 2>&1; then
    version=`gcc -dumpversion | cut -d. -f1`
    [ "$version" = $GCC_VERSION ] ||
        problem "gcc is version $version; Rose builds only with gcc $GCC_VERSION"
    [ -d "`gcc -print-file-name=adainclude`" ] ||
        problem "gcc has no Ada run-time sources (adainclude); GNAT's gcc is needed"
fi

if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import yaml' 2>/dev/null ||
        problem "python3 has no yaml module (python3-pyyaml)"
else
    problem "python3 not found"
fi

# idle has no version number, so check what it generates instead.  An idle
# older than idle PR #136 generates an Open_Cap_Set that keeps the client's
# old interface cap, and mem's Kill_Process then deletes a cap number that
# can name another cap by then, such as the reply cap of the call it is
# serving (#1172).  The build would work, and the system fail at random.
if command -v "$IDLE" >/dev/null 2>&1; then
    idle_dir=build/check-env-idle
    rm -rf "$idle_dir"
    mkdir -p "$idle_dir/out"
    printf 'interface Check.Probe is\n   procedure Ping;\nend Check.Probe;\n' \
        > "$idle_dir/check-probe.idl"
    if ! "$IDLE" -o "$idle_dir/out" "$idle_dir/check-probe.idl" \
        > "$idle_dir/idle.log" 2>&1
    then
        problem "$IDLE fails on a one-operation interface; see $idle_dir/idle.log"
    elif ! grep -q "Client.Interface_Cap := Rose.Capabilities.Null_Capability" \
        "$idle_dir/out/rose-interfaces-check-probe-client.adb"
    then
        problem "$IDLE is too old: its Open_Cap_Set keeps a stale interface cap; build idle from main (idle PR #136 or later)"
    fi
    rm -rf "$idle_dir"
fi

if [ $failed = yes ]; then
    echo "check-env: the build can't run until these are fixed" >&2
    exit 1
fi
echo "check-env: ok"
