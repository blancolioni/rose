#!/bin/sh
# Write Rose.Interface_Level, which says which interfaces this build has
# (ADR 0031, section 2; #375).  The kernel records it in each checkpoint's
# kernel tables, and the restore server refuses a checkpoint that was
# written with interfaces this build doesn't have.
#
#   Series_Major, Series_Minor  the release series, from Rose.Version
#   Level                       the number of endpoint ids in
#                               interfaces/endpoint-ids.txt
#   Hash                        the first 64 bits of the SHA-256 of that
#                               file
#
# Within a series, endpoint-ids.txt only gains ids (#827), so a build
# whose level is at least a checkpoint's has every id the checkpoint's
# processes hold.  At the same level, the hashes must match too, which
# catches a build whose ids changed without their number changing.
#
# Run it from the top of the tree.  The file is only rewritten when it
# changes, so that an unchanged build doesn't recompile the units that use
# it.  It doesn't use cmp, which CI doesn't have.

OUT=build/version/rose-interface_level.ads
LIST=interfaces/endpoint-ids.txt
VERSION=src/base/rose-version.ads

MAJOR=$(sed -n 's/.*Version_Major *: constant := \([0-9]*\);.*/\1/p' $VERSION)
MINOR=$(sed -n 's/.*Version_Minor *: constant := \([0-9]*\);.*/\1/p' $VERSION)
[ -n "$MAJOR" ] && [ -n "$MINOR" ] || {
    echo "make-interface-level: no Version_Major or Version_Minor in $VERSION" >&2
    exit 1
}

[ -f $LIST ] || {
    echo "make-interface-level: no $LIST" >&2
    exit 1
}
LEVEL=$(grep -c '^16#' $LIST)
HASH=$(sha256sum $LIST | cut -c1-16 | tr a-f A-F)

mkdir -p build/version
cat > $OUT.new <<END
--  Generated by scripts/make-interface-level: do not edit.

package Rose.Interface_Level is

   pragma Pure (Rose.Interface_Level);

   --  The interfaces of this build (ADR 0031, section 2): the release
   --  series, the number of endpoint ids in interfaces/endpoint-ids.txt,
   --  and the first 64 bits of the file's SHA-256.

   Series_Major : constant := $MAJOR;
   Series_Minor : constant := $MINOR;
   Level        : constant := $LEVEL;
   Hash         : constant := 16#$HASH#;

end Rose.Interface_Level;
END

if [ -f $OUT ] && [ "$(cat $OUT.new)" = "$(cat $OUT)" ]
then
    rm $OUT.new
else
    mv $OUT.new $OUT
fi
