#!/bin/sh
# Boot test of the whole system, under QEMU.
#
#   scripts/test-boot [ISO]
#
# ISO is the install image, images/rose.iso by default. The test:
#
#   1. installs Rose on a new disk, waits for the install to finish, and
#      checks that init's derive test (#116) and swap test (#862) passed;
#   2. boots from the disk, which restores the checkpoint, checks that the
#      kernel restored the derivation records that init gave hold_derived,
#      and that a restored process names them, and that hold_derived
#      found its derived capability working and revoked by rescinding its
#      parent (#691), and that the cap set server was restored with
#      init's set (#825); then logs in as the first user, and runs
#      run_self_tests, which has to
#      pass every test, then keytest, which has to draw in the corners of
#      the 80 by 24 screen and move its mark with the arrow keys (#734),
#      then kilo, which has to make, save and read back a file, and drop
#      a change that isn't saved (#735); then logs out and in again,
#      which ends the first session's bank and makes another (#450);
#   3. waits for a checkpoint, stops the machine, and runs check-log.py on
#      the disk, which has to find the checkpoint log consistent.
#
# It takes about ten minutes, and needs qemu-system-i386, qemu-img and
# python3. It exits with 0 if everything passed, and keeps the disk image
# and QEMU's files if anything failed.

ISO=${1:-images/rose.iso}
HERE=$(cd "$(dirname "$0")" && pwd)

command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

install_rose "$ISO"

echo "Booting from the disk, which restores the install's checkpoint"
start_qemu
choose_last_entry
log_in

# Init gives hold_derived, which is persistent, two derived capabilities,
# so the install's checkpoint has two derivation records, which the kernel
# puts back, and counts the capabilities of the restored processes that
# name them when the first one resumes: hold_derived's (#691).
records=$(grep -h "derivation records restored" "$WORK/serial" | tail -1)
echo "$records"
count=$(echo "$records" | sed -n 's/.*restored: \([0-9][0-9]*\).*/\1/p')
named=$(echo "$records" | sed -n 's/.*capabilities: \([0-9][0-9]*\).*/\1/p')
[ -n "$count" ] && [ "$count" -ge 2 ] \
    || fail "the kernel did not restore the derivation records"
[ -n "$named" ] && [ "$named" -ge 2 ] \
    || fail "no restored process names the derivation records"

# Hold_derived checks its capabilities the first time it is restored,
# and writes the result to the console, before the screen is cleared.
screen > "$WORK/restored-screen.txt"
grep "hold_derived:" "$WORK/restored-screen.txt" | tail -1
grep -q "hold_derived: restored: the derived capability works" \
    "$WORK/restored-screen.txt" \
    || fail "hold_derived did not find its restored capability working and revocable"

# caps writes what it holds when it is restored. Init leaves it one set,
# of two capabilities, for this check (#825); the install's self tests
# release theirs.
grep "caps: restored" "$WORK/restored-screen.txt" | tail -1
grep -q "caps: restored sets 1; caps 2" "$WORK/restored-screen.txt" \
    || fail "the cap set server did not restore init's set"

echo "Running the self tests"
# The restored screen can still show the install's test result.
type_text "clear
"
sleep 5
type_text "run_self_tests
"
wait_for "Test result:" 120 || fail "the self tests did not finish"
result=$(screen | grep "Test result:" | tail -1)
echo "$result"
set -- $(echo "$result" \
    | sed -n 's/.*tests \([0-9][0-9]*\); passed \([0-9][0-9]*\);.*/\1 \2/p')
[ $# -eq 2 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] \
    || fail "not every self test passed"

# Each run launches the servers that it tests against its own bank, so
# they end when it does. The third run used to fill the process table
# and hang (#724, ADR 0015).
for run in 2 3; do
    echo "Running the self tests again ($run)"
    type_text "clear
"
    sleep 5
    type_text "run_self_tests
"
    wait_for "Test result:" 120 || fail "self tests run $run did not finish"
    result=$(screen | grep "Test result:" | tail -1)
    echo "$result"
    set -- $(echo "$result" \
        | sed -n 's/.*tests \([0-9][0-9]*\); passed \([0-9][0-9]*\);.*/\1 \2/p')
    [ $# -eq 2 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] \
        || fail "not every self test passed in run $run"
done

echo "Running keytest on the 80 by 24 text screen"
check_keytest

echo "Editing a file with kilo"
check_kilo

# An end of file logs out of petal (#458). Login then destroys the
# session's bank, and makes a new one from the user's bank for the next
# session (#450).
echo "Logging out, and in again"
type_text "clear
"
sleep 3
press ctrl-d
wait_for "login:" 60 || fail "logging out did not bring back the login prompt"
log_in
type_text "echo second session
"
wait_for "^second session" 20 || fail "the second session does not run commands"

echo "Waiting for a checkpoint, then stopping the machine"
sleep 45
stop_qemu

echo "Checking the log"
python3 "$HERE/check-log.py" "$DISK" || {
    echo "FAIL: the log is not consistent; the disk image is in $WORK"
    exit 1
}

rm -rf "$WORK"
echo "PASS"
