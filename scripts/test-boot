#!/bin/sh
# Boot test of the whole system, under QEMU.
#
#   scripts/test-boot [ISO]
#
# ISO is the install image, images/rose.iso by default. The test:
#
#   1. installs Rose on a new disk, and waits for the install to finish;
#   2. boots from the disk, which restores the checkpoint, checks that the
#      kernel restored the derivation records that init's test left, and
#      that the cap set server that holds them was restored with them,
#      logs in as the first user, and runs run_self_tests, which has to
#      pass every test, then keytest, which has to draw in the corners of
#      the 80 by 24 screen and move its mark with the arrow keys (#734),
#      then kilo, which has to make, save and read back a file, and drop
#      a change that isn't saved (#735);
#   3. waits for a checkpoint, stops the machine, and runs check-log.py on
#      the disk, which has to find the checkpoint log consistent.
#
# It takes about ten minutes, and needs qemu-system-i386, qemu-img and
# python3. It exits with 0 if everything passed, and keeps the disk image
# and QEMU's files if anything failed.

ISO=${1:-images/rose.iso}
HERE=$(cd "$(dirname "$0")" && pwd)

command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

install_rose "$ISO"

echo "Booting from the disk, which restores the install's checkpoint"
start_qemu
choose_last_entry
log_in

# Init's derive test leaves two derived capabilities in a set of the
# userland cap set server, caps, so the install's checkpoint has two
# derivation records, which the kernel puts back.  It counts the
# capabilities of the processes that it restored that name them when the
# first one resumes: caps is restored, so its two do (#825).
records=$(grep -h "derivation records restored" "$WORK/serial" | tail -1)
echo "$records"
count=$(echo "$records" | sed -n 's/.*restored: \([0-9][0-9]*\);.*/\1/p')
named=$(echo "$records" | sed -n 's/.*capabilities: \([0-9][0-9]*\).*/\1/p')
[ -n "$count" ] && [ "$count" -ge 2 ] \
    || fail "the kernel did not restore the derivation records"
[ -n "$named" ] && [ "$named" -ge 2 ] \
    || fail "no restored capability names the derivation records"

# caps writes what it holds when it is restored. The install's self tests
# release their sets, so it holds init's one set, of two capabilities.
caps=$(screen | grep "caps: restored" | tail -1)
echo "$caps"
echo "$caps" | grep -q "caps: restored sets 1; caps 2" \
    || fail "the cap set server did not restore init's set"

echo "Running the self tests"
# The restored screen can still show the install's test result.
type_text "clear
"
sleep 5
type_text "run_self_tests
"
wait_for "Test result:" 120 || fail "the self tests did not finish"
result=$(screen | grep "Test result:" | tail -1)
echo "$result"
set -- $(echo "$result" \
    | sed -n 's/.*tests \([0-9][0-9]*\); passed \([0-9][0-9]*\);.*/\1 \2/p')
[ $# -eq 2 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] \
    || fail "not every self test passed"

echo "Running keytest on the 80 by 24 text screen"
check_keytest

echo "Editing a file with kilo"
check_kilo

echo "Waiting for a checkpoint, then stopping the machine"
sleep 45
stop_qemu

echo "Checking the log"
python3 "$HERE/check-log.py" "$DISK" || {
    echo "FAIL: the log is not consistent; the disk image is in $WORK"
    exit 1
}

rm -rf "$WORK"
echo "PASS"
