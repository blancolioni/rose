#!/bin/sh
# Boot test of the whole system, under QEMU.
#
#   scripts/test-boot [ISO]
#
# ISO is the install image, images/rose.iso by default. The test:
#
#   1. installs Rose on a new disk, waits for the install to finish, and
#      checks that init's derive test (#116) and swap test (#862) passed,
#      and that hold_pages filled its 48 MiB (#975);
#   2. boots from the disk, which restores the checkpoint, checks that the
#      kernel restored the derivation records that init gave hold_derived,
#      and that a restored process names them, and that hold_derived
#      found its derived capability working and revoked by rescinding its
#      parent (#691), that hold_pages found its 48 MiB intact (#975),
#      and that the cap set server was restored with init's set (#825);
#      then logs in as the first user, and runs
#      run_self_tests, which has to
#      pass every test, then keytest, which has to draw in the corners of
#      the 80 by 24 screen and move its mark with the arrow keys (#734),
#      then kilo, which has to make, save and read back a file, and drop
#      a change that isn't saved (#735); then logs out and in again,
#      which ends the first session's bank and makes another (#450);
#   3. waits for a checkpoint, checks that it lists no self-test probe
#      left starting (#915), stops the machine, and runs check-log.py on
#      the disk, which has to find the checkpoint log consistent; and
#      checks that the marker of hold_transient, a transient process
#      (#524), and the first user's password (#1059) are nowhere on the
#      disk.
#
# It takes about ten minutes, and needs qemu-system-i386, qemu-img and
# python3. It exits with 0 if everything passed, and keeps the disk image
# and QEMU's files if anything failed.

ISO=${1:-images/rose.iso}
HERE=$(cd "$(dirname "$0")" && pwd)

command -v qemu-system-i386 > /dev/null || {
    echo "qemu-system-i386 not found"
    exit 2
}
. "$HERE/qemu-test-lib.sh"

# A password that is nowhere else on the disk, so that the end of the
# test can look for it there (#1059).
first_password=k9ojx3wq

install_rose "$ISO"

# The next boot writes over CONSOLE and the serial log, so keep the install's.
cp "$CONSOLE" "$WORK/install-console"
cp "$WORK/serial" "$WORK/install-serial"

# The console supervisor launches nothing before the restart, so nothing
# asks for a login once the install has finished (#512, #526).
if sed -n '/The system is installed/,$p' "$CONSOLE" | grep -q "login:"; then
    fail "login asked for a user before the restart"
fi

# Hold_pages fills 48 MiB, more than the machine has, during the install
# (#975).
grep "hold_pages:" "$CONSOLE" | tail -1
grep -q "hold_pages: filled 12288 pages: ok" "$CONSOLE" \
    || fail "hold_pages did not fill its pages at the install"

# Hold_transient is transient (#524): it holds a marker in pages that no
# checkpoint may save.
grep "hold_transient:" "$CONSOLE" | tail -1
grep -q "hold_transient: holding its marker" "$CONSOLE" \
    || fail "hold_transient did not start at the install"

echo "Booting from the disk, which restores the install's checkpoint"
start_qemu
choose_last_entry
log_in

# Init gives hold_derived, which is persistent, two derived capabilities,
# so the install's checkpoint has two derivation records, which the kernel
# puts back, and counts the capabilities of the restored processes that
# name them when the first one resumes: hold_derived's (#691).
records=$(grep -h "derivation records restored" "$WORK/serial" | tail -1)
echo "$records"
count=$(echo "$records" | sed -n 's/.*restored: \([0-9][0-9]*\).*/\1/p')
named=$(echo "$records" | sed -n 's/.*capabilities: \([0-9][0-9]*\).*/\1/p')
[ -n "$count" ] && [ "$count" -ge 2 ] \
    || fail "the kernel did not restore the derivation records"
[ -n "$named" ] && [ "$named" -ge 2 ] \
    || fail "no restored process names the derivation records"

# The transient hold_transient was not saved, so it isn't restored, and
# the store destroyed its bank (#524). The restored processes are named,
# so hold_pages, which is persistent, must be among them.
grep -q "restored process [0-9]*/hold_pages\[" "$WORK/serial" \
    || fail "the kernel did not name the restored hold_pages"
if grep -q "restored process [0-9]*/hold_transient" "$WORK/serial"; then
    fail "the transient hold_transient was restored"
fi
grep "storage: restore: transient banks:" "$CONSOLE" | tail -1
grep -q "storage: restore: transient banks: [1-9]" "$CONSOLE" \
    || fail "the store did not destroy the transient bank at the restore"

# Hold_derived checks its capabilities the first time it is restored,
# and writes the result to the console.
grep "hold_derived:" "$CONSOLE" | tail -1
grep -q "hold_derived: restored: the derived capability works" "$CONSOLE" \
    || fail "hold_derived did not find its restored capability working and revocable"

# Hold_file holds a file that init replaced with a new version during the
# install, with a writer and a reader open, and checks them the first time
# it is restored (#867).
grep "hold_file:" "$CONSOLE" | tail -1
grep -q "hold_file: restored: the replaced file has its contents" "$CONSOLE" \
    || fail "hold_file did not find its replaced file intact after the restore"

# Hold_home holds a user server and a home directory that init replaced
# with new versions during the install, with a session open, and checks
# them the first time it is restored (#831).
grep "hold_home:" "$CONSOLE" | tail -1
grep -q "hold_home: restored: the replaced user has its name" "$CONSOLE" \
    || fail "hold_home did not find its replaced user intact after the restore"

# Hold_pages checks every page each time it is restored (#975). It checks
# while the login runs, so its report can come after it.
wait_for_console "hold_pages: restore 1:" 300 \
    || fail "hold_pages did not report the restore"
grep "hold_pages: restore 1:" "$CONSOLE" | tail -1
grep -q "hold_pages: restore 1: 12288 pages intact" "$CONSOLE" \
    || fail "hold_pages found its pages wrong after the restore"

# caps writes what it holds when it is restored. Init leaves it one set,
# of two capabilities, for this check (#825); the install's self tests
# release theirs.
grep "caps: restored" "$CONSOLE" | tail -1
grep -q "caps: restored sets 1; caps 2" "$CONSOLE" \
    || fail "the cap set server did not restore init's set"

echo "Running the self tests"
# Only this run's result counts: the install's is in CONSOLE too.
mark=$(console_mark)
type_text "run_self_tests
"
wait_for_console "Test result:" 120 "$mark" \
    || fail "the self tests did not finish"
result=$(console_since "$mark" | grep "Test result:" | tail -1)
echo "$result"
set -- $(echo "$result" \
    | sed -n 's/.*tests \([0-9][0-9]*\); passed \([0-9][0-9]*\);.*/\1 \2/p')
[ $# -eq 2 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] \
    || fail "not every self test passed"

# Each run launches the servers that it tests against its own bank, so
# they end when it does. The third run used to fill the process table
# and hang (#724, ADR 0015).
for run in 2 3; do
    echo "Running the self tests again ($run)"
    mark=$(console_mark)
    type_text "run_self_tests
"
    wait_for_console "Test result:" 120 "$mark" \
        || fail "self tests run $run did not finish"
    result=$(console_since "$mark" | grep "Test result:" | tail -1)
    echo "$result"
    set -- $(echo "$result" \
        | sed -n 's/.*tests \([0-9][0-9]*\); passed \([0-9][0-9]*\);.*/\1 \2/p')
    [ $# -eq 2 ] && [ "$1" -gt 0 ] && [ "$1" -eq "$2" ] \
        || fail "not every self test passed in run $run"
done

echo "Running keytest on the 80 by 24 text screen"
check_keytest

echo "Editing a file with kilo"
check_kilo

# The system directory and its null (ADR 0035), which petal names
# //system (ADR 0044): list shows null as a special file, writing to it
# succeeds and keeps nothing, and reading it gives nothing.
echo "Using //system/null"
mark=$(console_mark)
type_text "list //system
"
wait_for_console "null  (special file)" 20 "$mark" \
    || fail "list //system does not show null as a special file"
wait_for_console "null-directory  (directory)" 20 "$mark" \
    || fail "list //system does not show the null directory"
type_text "echo discarded > //system/null
"
type_text "cat //system/null
"
type_text "echo null done
"
wait_for_console "^null done" 20 "$mark" \
    || fail "petal stopped after using //system/null"
if console_since "$mark" | grep -q "^discarded\|petal: "; then
    console_since "$mark"
    fail "//system/null kept what was written, or petal refused it"
fi

# //system/version (ADR 0036, section 8; #1121), an ordinary file that
# init made read-only: cat shows the version, writing to it is refused
# and leaves it as it was, and kilo, which takes a File or a version of
# one (ADR 0012, section 6), opens it as a viewer (#792).
echo "Using //system/version"
mark=$(console_mark)
type_text "cat //system/version
"
wait_for_console "^Rose Version " 20 "$mark" \
    || fail "cat //system/version did not show the version"
type_text "echo changed > //system/version
"
type_text "cat //system/version
"
type_text "echo version done
"
wait_for_console "^version done" 20 "$mark" \
    || fail "petal stopped after writing to //system/version"
if ! console_since "$mark" | grep -q "petal: "; then
    console_since "$mark"
    fail "petal did not refuse to write to //system/version"
fi
if console_since "$mark" | grep -q "^changed"; then
    console_since "$mark"
    fail "//system/version was changed"
fi
type_text "kilo //system/version
"
wait_for "(read-only)" 30 \
    || fail "kilo did not open //system/version read-only"
type_text "x"
wait_for "Read-only: kilo can.t change this file" 10 \
    || fail "kilo did not refuse to change //system/version"
press ctrl-q
sleep 3

# Petal's paths (ADR 0044): cd to a named directory, which pwd writes as
# a path, a path from there, and cd with no argument back to //home.
echo "Using paths"
mark=$(console_mark)
type_text "cd //system
"
type_text "pwd
"
wait_for_console "^//system" 20 "$mark" \
    || fail "pwd did not write //system after cd //system"
type_text "cat null
"
type_text "cd
"
type_text "pwd
"
wait_for_console "^//home" 20 "$mark" \
    || fail "cd with no argument did not go back to //home"
if console_since "$mark" | grep -q "petal: "; then
    console_since "$mark"
    fail "petal refused a path"
fi

# A path without // starts from the current directory, so system/null
# in //home is not the special file; .. above a named directory, and a
# scheme, are errors.
mark=$(console_mark)
type_text "cat system/null
"
wait_for_console "no directory named 'system'" 20 "$mark" \
    || fail "system/null was not a path from //home"
type_text "cd ..
"
wait_for_console "has no parent" 20 "$mark" \
    || fail "cd .. went above //home"
type_text "cat x:y
"
wait_for_console "knows no scheme" 20 "$mark" \
    || fail "petal did not refuse a scheme"

# An end of file logs out of petal (#458). Login then destroys the
# session's bank, and makes a new one from the user's bank for the next
# session (#450).
echo "Logging out, and in again"
type_text "clear
"
sleep 3
press ctrl-d
wait_for "login:" 60 || fail "logging out did not bring back the login prompt"
# The password is typed in two parts, with a checkpoint between them, so
# that the console holds the first part while the checkpoint runs. What
# is typed is in memory that checkpoints don't save (#1132), so the
# check for the password on the disk, below, still finds nothing.
sleep 45
type_text "$first_user
"
wait_for "password:" 20 || fail "no password prompt"
type_text "$(echo "$first_password" | cut -c1-6)"
wait_for_checkpoint 180 \
    || fail "no checkpoint while the password was being typed"
type_text "$(echo "$first_password" | cut -c7-)
"
wait_for "petal>" 60 || fail "could not log in a second time"
type_text "echo second session
"
wait_for "^second session" 20 || fail "the second session does not run commands"

echo "Waiting for a checkpoint, then stopping the machine"
sleep 45
stop_qemu

# The self tests end every probe that they launch, including in the
# process limit test, where the last launch fails. A failed launch used
# to leave its process in the kernel's table, never started (#915), so
# the last checkpoint must not list a probe.
probes=$(awk '/Entering checkpoint/ { n = 0 }
              /process_probe\[S\]: disable write pages/ { n++ }
              END { print n + 0 }' "$WORK/serial")
[ "$probes" -eq 0 ] || {
    echo "FAIL: $probes probes left starting at the last checkpoint;" \
         "the disk image is in $WORK"
    exit 1
}

echo "Checking the log"
python3 "$HERE/check-log.py" "$DISK" > "$WORK/check-log.out" || {
    cat "$WORK/check-log.out"
    echo "FAIL: the log is not consistent; the disk image is in $WORK"
    exit 1
}
cat "$WORK/check-log.out"

# Init's page test fills memory with no checkpoints, so mem pages changed
# pages out to the log between them (#974).
grep -q "paged out before the checkpoint" "$WORK/check-log.out" || {
    echo "FAIL: no entry has pages paged out between checkpoints;" \
         "the disk image is in $WORK"
    exit 1
}

# The first user's password went through the console and auth, which
# are persistent, at the install and at each login, and must not reach
# the disk (#1059), even though a checkpoint ran while the second login's
# was being typed (#1132).
# Any six characters of it in a row count: a line that was read stayed
# in the console's buffer until later lines were typed over it, and the
# next one could cover only its start.
echo "Looking for the first user's password on the disk"
windows=$(echo "$first_password" | awk '{
    for (i = 1; i + 5 <= length($0); i++) {
        printf "%s%s", sep, substr($0, i, 6); sep = "|"
    }
}')
if grep -q -a -E "$windows" "$DISK"; then
    echo "FAIL: the first user's password is on the disk;" \
         "the disk image is in $WORK"
    exit 1
fi

# The consoles keep what is typed in unsaved memory, which a restore
# finds as zeros; a trace event says if it wasn't (#1132).
if grep -a -q "console: typed input was saved" "$WORK/install-serial" \
     "$WORK/serial"; then
    echo "FAIL: a checkpoint saved what was typed at the console;" \
         "the disk image is in $WORK"
    exit 1
fi

# Hold_transient wrote its marker through 16 pages, which no checkpoint
# and no paging may write to the disk (#524).
echo "Looking for hold_transient's marker on the disk"
if grep -q -a "rose-524-transient-marker" "$DISK"; then
    echo "FAIL: hold_transient's marker is on the disk;" \
         "the disk image is in $WORK"
    exit 1
fi

rm -rf "$WORK"
echo "PASS"
