--  The project that gnatprove proves (make prove).
--
--  A package is in SPARK when it has SPARK_Mode on, in the package itself:
--  there is no configuration pragma, so the rest of Rose is unaffected.
--  Adding a package to the proof means turning SPARK_Mode on in it and
--  listing its files in Source_Files below.  gnatprove has to compile
--  every unit that the project lists, so the list names the SPARK packages
--  and not the directories they are in: the directories hold units that need
--  the generated interfaces, and are on Source_Dirs only so that the SPARK
--  packages can find what they depend on.
--
--  Contracts are proved, not executed, and the run-time has no assertions,
--  so nothing here turns them on: no -gnata, and no Assertion_Policy.
--
--  The run-time system is the userland one.  The kernel has its own, so the
--  packages that only the kernel uses will need a project of their own.

project Spark is

   for Source_Dirs use
     ("../src/base",
      "../src/library",
      "../src/library/rose",
      "../src/library/capabilities",
      "../src/library/kernelapi");

   for Source_Files use
     ("rose.ads",
      "rose-invocation.ads",
      "rose-invocation.adb",
      "rose-capabilities-layout.ads",
      "rose-capabilities-layout.adb");

   for Object_Dir use "../build/spark";

   for Runtime ("ada") use external ("ROSE_USER_RTS", "rts/user/build/i686-rose");

   package Compiler is
      --  gnatprove is a 64-bit program, and -m32 gives it the target's
      --  sizes, such as a 32-bit address.
      for Default_Switches ("ada") use
        ("-m32", "-gnat2020", "-gnatVa");
   end Compiler;

   package Prove is
      for Proof_Dir use "../build/spark/proof";
   end Prove;

end Spark;
