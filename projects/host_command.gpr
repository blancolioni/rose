--  A command built for the host's own Ada run-time, to test it without
--  booting Rose (#1101). mk/host.mk builds it, with the command's
--  directory and main as external variables, and names the executable
--  after the command. The command's own sources are the same as on Rose;
--  its spec, main and metadata are generated by idle --target host in
--  build/host/generated, and the host's side of it is in rose_host.gpr.
--  Like the command on Rose, it is Ada 2012.

with "../src/library/host/rose_host.gpr";

project Host_Command is

   Command_Dir := external ("HOST_COMMAND_DIR");
   Main_File   := external ("HOST_MAIN");

   for Source_Dirs use
     (Command_Dir & "/src", Command_Dir & "/build/host/generated");
   for Object_Dir use Command_Dir & "/build/host/obj";
   for Exec_Dir use Command_Dir & "/build/host/bin";
   for Main use (Main_File);

   package Compiler is
      for Default_Switches ("ada") use
        ("-g", "-gnat2012", "-gnata", "-gnato", "-gnatwa");
   end Compiler;

end Host_Command;
