--  A process that Executable.Launch has made and loaded, but not yet
--  started. An invocation carries at most four caps (#234), so the caps
--  that the process starts with are given one at a time: each one takes
--  the process's next cap slot, after its standard caps (see
--  Rose.Capabilities.Standard).
interface Processes.Starting_Process is

   procedure Add_Cap (Cap : Capability);

   --  Start the process. The result is its Process_Control cap, or for a
   --  command, the cap of its command endpoint. The Starting_Process
   --  cap is no use afterwards, and the caller deletes it.

   function Start return Capability;

   --  The process's own bank (ADR 0015): a null cap if it has none. The
   --  caller launched the process against the bank above it, so this
   --  gives it nothing that it couldn't do already. Exec registers a
   --  Storage.Dependent with it, to learn when the process ends, and
   --  frees a retired program's image once none of its processes run
   --  (#875). Asked before Start.

   function Bank return interface Storage.Bank;

end Processes.Starting_Process;
