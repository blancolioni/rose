interface Bank is

   --  A source of storage (ADR 0014). Every region is reserved from one
   --  bank and charged to it, and to every bank above it. A limit of zero
   --  is no limit.

   function Reserve_Storage
     (Size : Word_64)
      return interface Region;
   --  Fails, with a null cap, if the reservation would take the bank, or
   --  any bank above it, over a limit.

   function Create_Sub_Bank
     (Page_Limit   : Word_64;
      Region_Limit : Word)
      return interface Bank;

   function Add_Dependent
     (Signal : Capability)
      return interface Dependent;
   --  Register an object that a server keeps on behalf of whoever holds
   --  this bank, such as a process or a slot (ADR 0014, section 3).
   --  Signal is a signal cap for one of the server's own bits (ADR
   --  0006). When this bank, or a bank above it, is destroyed, the
   --  storage server raises the signal, which never waits, and the
   --  Dependent says Destroyed. Fails, with a null cap, if the bank has
   --  been destroyed, or the storage server has no room for another.

   procedure Get_Usage
     (Pages        : out Word_64;
      Regions      : out Word;
      Page_Limit   : out Word_64;
      Region_Limit : out Word);
   --  What has been reserved from the bank and its sub-banks, and the
   --  bank's limits.

   --  Release every region reserved from the bank and its sub-banks, and
   --  destroy the sub-banks. Neither the bank, nor anything reserved from
   --  it, can be used afterwards. The root bank can't be destroyed.

   procedure Destroy;

   function Index return Word;
   --  The bank's index in the storage server's table, which names it
   --  to Process_Banks (#750). Knowing it grants nothing.

end Bank;
