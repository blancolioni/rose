interface Processes.Exec : Processes.Launch is

   --  Install_Caps is a cap set (Caps.Cap_Set) of the caps that every
   --  process of the program starts with, after its standard caps, or
   --  the null cap for none. Exec copies them out of it, at most 16, and
   --  the caller can release the set afterwards (#234).

   function Install
     (Executable   : interface Streams.Reader;
      Name         : String;
      Install_Caps : Capability)
     return interface Processes.Launch;

   --  The standard output that exec gives the programs it launches, and
   --  uses itself.

   procedure Set_Standard_Output (Output : interface Streams.Writer);

   --  Install a new version of the program installed as Name, on the
   --  update boot (ADR 0031, #829). If the image is the same as the
   --  installed version's, and neither has install caps, nothing is
   --  installed, and the result is the installed version's Launch.
   --  Otherwise the new version is installed, and the old one is
   --  retired: its pages stay while processes run it, because they map
   --  them, and are freed when the last one ends (#875). Its launch caps
   --  launch the new version from then on (#902). With no program called Name, it is the same as Install.

   function Update
     (Executable   : interface Streams.Reader;
      Name         : String;
      Install_Caps : Capability)
     return interface Processes.Launch;

end Processes.Exec;
