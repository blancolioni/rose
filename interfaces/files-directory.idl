--  A directory, read-only all the way down: everything it gives is
--  read-only too, the reading side of a special file included (ADR 0003,
--  section 1; ADR 0036, case 2). Its entries are a Tree (ADR 0042): a
--  directory is a branch, an ordinary file a leaf, and a special file
--  another kind of entry.

interface Files.Directory : Common.Tree is

   type File_Kind is (Directory, Ordinary_File, Special_File);

   function Entry_File_Kind (Index : Positive) return File_Kind;
   function Entry_Size (Index : Positive) return Storage_Count;

   function Get_Ordinary_File (Index : Positive) return interface Files.File;
   function Get_Directory (Index : Positive) return interface Files.Directory;

   function Get_Special_Reader
     (Index : Positive) return interface Streams.Reader;
   --  The reading side of a special file. Fails if the entry isn't one.

end Files.Directory;
