interface Memory is

   type Page_Access_Type is (Read, Write, Execute);
   
   function New_Process
     (Process     : interface Kernel_Process;
      Bank        : interface Bank)
     return interface Process;
   --  Bank is the bank that the process is launched against. Its own
   --  bank is a new sub-bank of it (ADR 0015, #750), which
   --  Process.Bank returns.
   
   procedure Register_Process
     (Process     : interface Process;
      Exec_Base   : Word;
      Exec_Bound  : Word;
      Text_Base   : Word;
      Text_Bound  : Word;
      Data_Base   : Word;
      Data_Bound  : Word;
      Stack_Base  : Word;
      Stack_Bound : Word);
      
   procedure Page_Fault
     (Faulting_Object : Object_Id;
      Virtual_Page    : Word;
      Physical_Page   : Word;
      Action          : Page_Access_Type);
   
   procedure Take_Physical_Memory
     (Size   : Word;
      Start  : out Word;
      Amount : out Word);
     
   procedure Checkpoint
     (Append_Page : Capability);

   procedure Set_Process_Banks
     (Banks : interface Process_Banks);
   --  The storage server's Process_Banks, which init gives mem at every
   --  boot, once the store is running (#750).

   procedure Processes_Ended;
   --  The store has queued processes to end, because their banks were
   --  destroyed: mem asks Process_Banks.Take_Ended for each, and ends
   --  it. The store sends this without waiting.
	 
end Memory;
