interface Users.User : Common.Named is

   function Home_Directory return interface Files.Writable_Directory;

   function New_Session return interface Storage.Bank;
   --  A bank for a new session of the user's: a sub-bank of the user's
   --  bank, with no limits (ADR 0014, section 2; #450). Whoever ends the
   --  session destroys it, which ends what the session launched and
   --  releases what it reserved.

   function First_Process return interface Processes.Launch;
   --  The program the user starts with, as a Unix user's shell is (#525):
   --  the console supervisor launches it after a login (#512). For now
   --  it is always petal. Raises Invocation_Error if the user server has
   --  none, as one that took over from a version before #525 hasn't.

end Users.User;
