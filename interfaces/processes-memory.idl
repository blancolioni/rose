interface Processes.Memory is

   type Page_Access_Type is (Read, Write, Execute);
   
   function New_Process
     (Process     : interface Processes.Kernel_Process;
      Bank        : interface Storage.Bank;
      Transient   : Boolean)
     return interface Processes.Process;
   --  Bank is the bank that the process is launched against. Its own
   --  bank is a new sub-bank of it (ADR 0015, #750), which
   --  Process.Bank returns. A Transient process is never saved (#524):
   --  mem leaves it out of every checkpoint and maps its writable pages
   --  so that they are never written to the log, and its bank is a
   --  transient one.
   
   procedure Register_Process
     (Process     : interface Processes.Process;
      Exec_Base   : Word;
      Exec_Bound  : Word;
      Text_Base   : Word;
      Text_Bound  : Word;
      Data_Base   : Word;
      Data_Bound  : Word;
      Stack_Base  : Word;
      Stack_Bound : Word);
      
   procedure Page_Fault
     (Faulting_Object : Object_Id;
      Virtual_Page    : Word;
      Physical_Page   : Word;
      Action          : Page_Access_Type);
   
   procedure Take_Physical_Memory
     (Size   : Word;
      Start  : out Word;
      Amount : out Word);
     
   procedure Checkpoint
     (Request_Checkpoint : Capability);
   --  Write the memory server's part of the checkpoint to the open log
   --  entry, through its Page_Log. Request_Checkpoint is the checkpoint
   --  server's Checkpointer.Request_Checkpoint, which the memory server
   --  keeps, to ask for a checkpoint later (ADR 0028, section 6).

   procedure Set_Process_Banks
     (Banks : interface Storage.Process_Banks);
   --  The storage server's Process_Banks, which init gives mem at every
   --  boot, once the store is running (#750).

   procedure Processes_Ended;
   --  The store has queued processes to end, because their banks were
   --  destroyed: mem asks Process_Banks.Take_Ended for each, and ends
   --  it. The store sends this without waiting.

   procedure Set_Page_Log
     (Log : interface Checkpoints.Page_Log);
   --  The log server's Page_Log, which init gives mem at every boot, once
   --  the log server is running. Mem appends its pages to the open log
   --  entry through it (ADR 0028).

   procedure Log_Committed;
   --  The log server has committed an entry and opened the next, so
   --  the memory server cleans the log a little: it copies the live
   --  pages of the oldest entries forward, so that their space can be
   --  freed (#952). The log server sends this without waiting, and it
   --  is lost if the memory server is busy; the next commit sends it
   --  again.
	 
end Processes.Memory;
