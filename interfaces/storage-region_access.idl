interface Storage.Region_Access is

   --  The pages of a region, without the right to release it (#403). A
   --  process that uses a region it doesn't own holds this interface:
   --  mem for a code or shared segment, elf for a program's image, and
   --  the holder of a surface for its buffer. Closing its client never
   --  releases the region, as closing a Region client does (ADR 0010).
   --
   --  A process maps a region into its address space with
   --  Segment.Add_Segment. A shared segment (Segment_Shared, or
   --  Rose.Shared_Regions) maps the region's pages themselves, so every
   --  process that maps a page shared sees the same memory (ADR 0025).
   --  Get and Put don't see a shared mapping: while a page is mapped
   --  shared, Get returns what is on the device, which can be older, and
   --  a Put can be overwritten when the last mapping goes. A program that
   --  shares a region uses it only through mappings.

   procedure Get_Range
     (Base_Page : out Object_Id;
      Bound_Page : out Object_Id);

   procedure Get
     (Page : Object_Id;
      Data : out Storage_Array);

   procedure Put
     (Page : Object_Id;
      Data : Storage_Array);

   function Read return interface Streams.Reader;

end Storage.Region_Access;
