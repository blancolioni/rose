interface Region is

   --  A range of store pages. A process maps a region into its address
   --  space with Segment.Add_Segment. A shared segment (Segment_Shared,
   --  or Rose.Shared_Regions) maps the region's pages themselves, so
   --  every process that maps a page shared sees the same memory (ADR
   --  0025). Get and Put don't see a shared mapping: while a page is
   --  mapped shared, Get returns what is on the device, which can be
   --  older, and a Put can be overwritten when the last mapping goes. A
   --  program that shares a region uses it only through mappings.

   procedure Get_Range
     (Base_Page : out Object_Id;
      Bound_Page : out Object_Id);

   procedure Get
     (Page : Object_Id;
      Data : out Storage_Array);

   procedure Put
     (Page : Object_Id;
      Data : Storage_Array);
   
   function Read return interface Reader;
   
   function Create_Subregion
     (Subregion_Base  : Object_Id;
      Subregion_Bound : Object_Id;
      Flags           : Word)
     return interface Region;

   --  The region is no longer needed: free its storage, if it has its
   --  own, and the region itself. Neither it nor its subregions can be
   --  used afterwards.

   procedure Release;
     
end Region;