--  The directory and everything in it (ADR 0036): a child directory comes
--  back as a Writable_Directory.

interface Files.Writable_Directory : Files.Fixed_Directory
is

   function Get_Writable_Directory
     (Index : Positive) return interface Files.Writable_Directory;

   function Create_File (Name : String) return interface Files.Writable_File;
   function Create_Directory
     (Name : String) return interface Files.Writable_Directory;

   procedure Rename
     (From : String;
      To   : String);
   --  Give the entry From the name To. Only the entry changes: the file
   --  or directory is the same, so caps to it keep working. It fails if
   --  From is not an entry, or if To is already one, or is empty or too
   --  long.

   procedure Delete_File (Name : String);
   --  Remove the file Name, and end its process. It fails if Name is not
   --  a file. For a special file, it removes the entry and deletes the
   --  directory's cap, but doesn't end the server, which the directory
   --  didn't launch (ADR 0035, section 3).

   procedure Delete_Directory (Name : String);
   --  Remove the directory Name, and end its process. It fails if Name is
   --  not a directory, or if the directory has entries.

   procedure Add_Special_File
     (Name : String;
      File : interface Streams.Stream);
   --  Add an entry Name that holds File, a cap the directory keeps and
   --  hands out, rather than a file it serves (ADR 0035, section 3). It
   --  fails if Name is already an entry, or is empty or too long.

end Files.Writable_Directory;
