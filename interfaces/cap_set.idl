--  A set of caps, given in one cap.  Append copies caps into the set,
--  and Get_Cap copies one out, except a single-use cap, such as a reply
--  cap, which the kernel moves rather than copies (ADR 0032, #864): it
--  leaves the sender when it is appended, and leaves the set the first
--  time Get_Cap gives it out, after which Get_Cap gives the null cap at
--  its index.

interface Cap_Set is

   procedure Append
     (Caps : Capability_Array);
     
   function Get_Cap
     (Index : Positive)
     return Capability;

   function Length
     return Natural;
     
end Cap_Set;
