interface Checkpoints.Page_Log is

   --  The memory server's access to the checkpoint log (ADR 0028). The
   --  log keeps an entry open from one commit to the next, and the
   --  memory server appends its pages to it, between checkpoints and
   --  during one. A log page is a page's number within the log
   --  partition, from 0. Page 0 is the log's header, so 0 never names a
   --  page of an entry.

   function Append_Page (Page : Storage_Array) return Word;
   --  Append Page to the open entry, and return its log page, or 0 if
   --  it can't be appended. An append fails because the log is full,
   --  and then every append fails until the checkpoint commits or the
   --  memory server discards its batch. During a checkpoint, that fails
   --  the checkpoint: its pages are dropped when it commits, and the
   --  entry stays open with the pages appended before it started.
   --  Between checkpoints, the memory server drops its batch with
   --  Discard_Pages.
   --
   --  An append also fails because a write to the disk failed. The log
   --  can't tell which pages reached the disk, so the whole entry is
   --  left out of the log when the checkpoint commits, and the next
   --  entry starts where it did. Discard_Pages doesn't clear that.

   procedure Append_Batch
     (Pages : Storage_Array;
      First : out Word;
      Wrap  : out Word);
   --  Append Pages, a whole number of pages, to the open entry in one
   --  go: a batch of pages paged out between checkpoints, which is a
   --  header page and the pages it lists (ADR 0028, section 4). Nothing
   --  else is appended between them, so a checkpoint can't start in the
   --  middle of a batch (#974). First is the log page of the first page,
   --  and Wrap is how many pages went before the log wrapped round to
   --  log page 1, or 0 if it didn't, so that the page at Index from 0
   --  is at First + Index, or at 1 + Index - Wrap from Wrap on.
   --
   --  First is 0 if the batch wasn't appended: while a checkpoint is
   --  being written, or if an append fails. A batch that fails partway
   --  is dropped, and appends can go on, unless a write to the disk
   --  failed, which fails the whole entry as for Append_Page.

   procedure Read_Page
     (Log_Page : Word;
      Page     : out Storage_Array);
   --  Read log page Log_Page, from a committed entry or from the open
   --  one. A page that isn't in either reads as zeroes.

   procedure Fail_Checkpoint;
   --  Fail the checkpoint being written, as if an append had failed:
   --  its pages are dropped when it commits, and the entry stays open.
   --  The memory server calls it when its part of a checkpoint can't be
   --  completed.

   procedure Discard_Pages (From : Word);
   --  Drop log page From, which Append_Page returned for the open entry,
   --  and every page appended after it, and let appends go on. From 0
   --  drops no pages. Between checkpoints, the memory server calls it
   --  when an append of a batch fails, with the log page of the batch's
   --  first page, or 0 if that append failed. It does nothing during a
   --  checkpoint.

   procedure Free_Before (Log_Page : Word);
   --  When the open entry commits, start the log at the entry that holds
   --  log page Log_Page, which is in a committed entry or in the open
   --  one, so that the space of every entry before it can be written
   --  again (#951). The log's header is written after the entry's, so a
   --  crash between the two leaves the log starting where it did. A
   --  later call before the commit replaces an earlier one, and a
   --  checkpoint that doesn't commit forgets it. The memory server
   --  calls it once nothing it still needs is in those entries.

   procedure Get_Space
     (First : out Word;
      Open  : out Word;
      Last  : out Word;
      Free  : out Word);
   --  Where the log's entries are, for the memory server's cleaning
   --  (#952). First is the log page of the first committed entry's
   --  header, and Open that of the open entry's header, or 0 if no
   --  entry is open. First is Open if no entry is committed. Last is
   --  the log's last page, after which it wraps round to log page 1.
   --  Free is how many pages can be appended before the log is full,
   --  so that the memory server can keep a reserve (#1029).

   function Entry_Last (Header : Word) return Word;
   --  The log page of the last page of the committed entry whose
   --  header is at log page Header, or 0 if no committed entry's
   --  header is there. The entry's pages are those after its header
   --  up to that one, round the log, and the next entry's header is
   --  the page after it.

end Checkpoints.Page_Log;
