interface Storage.Region : Storage.Region_Access, Common.Resource is

   --  A range of store pages, held by the process that owns them: the
   --  one that reserved it from a bank, or that it was handed to, as elf
   --  hands a process's data, stack and heap to mem. Release, or Close,
   --  frees its storage, if it has its own, and the region itself.
   --  Neither it nor its subregions can be used afterwards. A process
   --  that hands the region on calls Forget instead of Close (#403).
   --
   --  A process that only uses the region is given its Region_Access,
   --  which a Region client converts to, and can't release it.

   function Create_Subregion
     (Subregion_Base  : Object_Id;
      Subregion_Bound : Object_Id;
      Flags           : Word)
     return interface Storage.Region;
   --  A region of some of this region's pages, which belongs to the
   --  owner of this one.

end Storage.Region;
