interface Exec : Launch is

   function Install 
     (Executable   : interface Reader;
      Name         : String;
      Install_Caps : Capability_Array)
     return interface Launch;

   --  The standard output that exec gives the programs it launches, and
   --  uses itself.

   procedure Set_Standard_Output (Output : interface Writer);

   --  Install a new version of the program installed as Name, on the
   --  update boot (ADR 0031, #829). If the image is the same as the
   --  installed version's, and neither has install caps, nothing is
   --  installed, and the result is the installed version's Launch.
   --  Otherwise the new version is installed, and the old one is
   --  retired: launching it fails from then on, but its pages stay,
   --  because the processes running it map them. With no program called
   --  Name, it is the same as Install.

   function Update
     (Executable   : interface Reader;
      Name         : String;
      Install_Caps : Capability_Array)
     return interface Launch;

end Exec;
