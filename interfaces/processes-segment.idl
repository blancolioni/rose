interface Processes.Segment is

   Segment_Readable    : constant := 1;
   Segment_Writable    : constant := 2;
   Segment_Executable  : constant := 4;
   Segment_Resizable   : constant := 8;
   Segment_Initialized : constant := 16;
   --  32 was Segment_Private, which Add_Private_Segment replaces (#403).
   Segment_Shared      : constant := 64;
   --  The segment maps the region's pages themselves, not copies of
   --  them: every process that maps a page of the region shared sees the
   --  same page, and its writes (ADR 0025). A shared segment can't
   --  overlap another segment of the process.

   procedure Add_Segment
     (Virtual_Base  : Word;
      Virtual_Bound : Word;
      Region        : interface Storage.Region_Access;
      Region_Offset : Word;
      Flags         : Word);
   --  Map a region that the process doesn't own, such as a program's
   --  image or a shared region. Removing the segment, or ending the
   --  process, leaves the region as it is.

   procedure Add_Private_Segment
     (Virtual_Base  : Word;
      Virtual_Bound : Word;
      Region        : interface Storage.Region;
      Flags         : Word);
   --  Map a region that belongs to the process from now on, from its
   --  first page, such as its data, stack or heap. The caller hands the
   --  region over, and forgets it rather than closing it. It is released
   --  when the segment is removed, or the process is gone (#403).

   procedure Add_Nonpersistent_Segment
     (Virtual_Base  : Word;
      Virtual_Bound : Word;
      Flags         : Word);

   procedure Remove_Segment
     (Virtual_Base : Word);
   --  Unmap the segment that starts at Virtual_Base. A page of a shared
   --  segment that nothing else maps is written back to its region, if
   --  it has been changed.

end Processes.Segment;
