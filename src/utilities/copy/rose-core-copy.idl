command Rose.Core.Copy : Standard_Error
  with Summary     => "Copy a file.",
       Description => """
          Copy writes the contents of SOURCE to TARGET, a file in the
          current directory, which is replaced if it exists and made if
          it doesn't. Copy commits TARGET only once the copy is complete
          (ADR 0026), so a copy that fails leaves TARGET as it was, or
          empty if it was made.
          """
is
   Source : in File
     with Help => "the file to copy";
   Target : in Transactional_Writable_File
     with Help => "the file to write";
end Rose.Core.Copy;
