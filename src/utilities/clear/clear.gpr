with "../../../projects/checks.gpr";
with "../../../rts/user/rose_rts.gpr";
with "../../../projects/user_library.gpr";

project Clear is

   --  The user-mode IDL target's packages for its own IDL files are
   --  generated in build/generated (#554). The interface packages and
   --  Rose's userland packages (src/library/rose) come from
   --  user_library.gpr (#1067), and the RTS's own units from rose_rts.gpr
   --  (#1080).

   for Source_Dirs use
      ("src",
       "build/generated");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("rose-core-clear_main.adb");

   package Builder is
      for Global_Configuration_Pragmas use "clear-pragmas.config";
      for Executable ("rose-core-clear_main.adb") use "clear-driver";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib", "-gnatVa", "-gnatwael", "-gnatyM79abcefhiklnoprst") & Checks.Switches
        & Checks.Optimisation_Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end Clear;
