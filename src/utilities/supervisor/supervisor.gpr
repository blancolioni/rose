with "../../../projects/checks.gpr";
with "../../../rts/user/rose_rts.gpr";
with "../../../projects/user_library.gpr";

project Supervisor is

   --  Built with the userland run-time system and the user-mode IDL target,
   --  whose packages for its own IDL files the Makefile generates in
   --  build/generated. The kernel target's packages, in
   --  kernelapi/generated, must not be on the path: the two targets have
   --  units with the same names. The interface packages and Rose's userland
   --  packages (src/library/rose) come from user_library.gpr (#1067), and
   --  the RTS's own units from rose_rts.gpr (#1080).

   --  The RTS's own units, its interface specs among them, come from
   --  rose_rts.gpr (#1080).

   for Source_Dirs use
      ("src",
       "build/generated",
       "../../../build/version");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("rose-core-supervisor_main.adb");

   package Builder is
      for Global_Configuration_Pragmas use "supervisor-pragmas.config";
      for Executable ("rose-core-supervisor_main.adb") use "supervisor-driver";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib", "-gnatVa", "-gnatwael", "-gnatyM79abcefhiklnoprst") & Checks.Switches
        & Checks.Optimisation_Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end Supervisor;
