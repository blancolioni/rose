project User is

   --  The RTS's own interface specs come first, so that the program
   --  uses them and not the other copies on its path (#538).

   for Source_Dirs use
      ("../../rts/build/interfaces",
       "src",
       "build/generated",
       "../../library/rose",
       "../../library/kernelapi/generated");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("rose-core-user_main.adb");

   package Builder is
      for Global_Configuration_Pragmas use "user-pragmas.config";
      for Executable ("rose-core-user_main.adb") use "user-driver";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../rts/build/i686-rose");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-gnata", "-gnato", "-gnatp", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib", "-gnatVa", "-gnatwael", "-gnatyM79abcefhiklnoprst");
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../rts/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end User;

