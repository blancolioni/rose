with "../../../projects/checks.gpr";

project Rmdir is

   --  The user-mode IDL target's packages are generated in
   --  build/generated (#554). The RTS's own interface specs come first,
   --  so that the program uses them and not the other copies on its path
   --  (#538).

   for Source_Dirs use
      ("../../../rts/user/build/interfaces",
       "src",
       "build/generated",
       "../../library/rose");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("rose-core-remove_directory_main.adb");

   package Builder is
      for Global_Configuration_Pragmas use "rmdir-pragmas.config";
      for Executable ("rose-core-remove_directory_main.adb") use "rmdir-driver";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib", "-gnatVa", "-gnatwael", "-gnatyM79abcefhiklnoprst") & Checks.Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end Rmdir;
