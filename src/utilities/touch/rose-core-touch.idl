command Rose.Core.Touch : Streams.Standard_Error
  with Summary     => "Create an empty file.",
       Description => """
          Touch creates an empty file called FILE, in the current
          directory unless FILE is a path. If FILE is already a file, it
          does nothing. Petal makes the file, if there is none, and gives
          touch a version of it, which touch commits (ADR 0026).
          """
is
   File : in Files.Transactional_Writable_File
     with Help => "the file to create";
end Rose.Core.Touch;
