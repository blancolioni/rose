with "../../../projects/checks.gpr";

project petal is

   --  Built with the userland run-time system and the user-mode IDL
   --  target, whose packages the Makefile generates in build/generated
   --  (#793). The kernel target's packages, in kernelapi/generated, must
   --  not be on the path: the two targets have units with the same names.

   --  The RTS's own interface specs come first, so that the program
   --  uses them and not the other copies on its path (#538).

   for Source_Dirs use
      ("../../../rts/user/build/interfaces",
       "./src",
       "./src/driver",
       "./src/launch",
       "./src/read",
       "./src/session",
       "./src/rose",
       "./build/generated",
       "../../library/rose");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("rose-core-petal_main.adb");

   package Builder is
      for Global_Configuration_Pragmas use "petal-pragmas.config";
      for Executable ("rose-core-petal_main.adb") use "petal-driver";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib", "-gnatVa", "-gnatwael", "-gnatyM79abcefhiklnoprst") & Checks.Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end petal;

