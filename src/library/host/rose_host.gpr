--  The host's side of a command built for the host's own Ada run-time
--  (#1101): Rose.Command_Line.Host, which binds the command line, the host
--  backings of the interfaces (Rose.Host), and the host's bodies of the
--  units that commands use from the userland run-time system
--  (Rose.Last_Chance) and from Rose's library (Rose.Clock). The interface
--  packages are generated by "make" here, with idle --target host.
--
--  A command's host project, projects/host_command.gpr, imports this, and
--  only what the command needs is compiled. Rose's library units come
--  after src, so src's host body of a unit is the one used.

project Rose_Host is

   for Source_Dirs use
     ("src",
      "build/generated",
      "../rose",
      "../capabilities",
      "../../base");
   for Object_Dir use "build/obj";

   package Compiler is
      for Default_Switches ("ada") use
        ("-g", "-gnat2012", "-gnata", "-gnato", "-gnatwa",
         "-gnatyM79abcefhiklnoprst");
   end Compiler;

end Rose_Host;
