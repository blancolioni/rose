with "../../../projects/checks.gpr";

project Surface_Console is

   --  Built with the userland run-time system and the user-mode IDL
   --  target, whose packages the Makefile generates in build/generated,
   --  like vga-console. It shares the console's cells and line discipline
   --  with vga-console (../text-console), maps the surface's buffer with
   --  Rose.Shared_Regions, and draws with Rose.Drawing.

   --  The RTS's own interface specs come first, so that the program
   --  uses them and not the other copies on its path (#538).

   for Source_Dirs use
      ("../../../rts/user/build/interfaces",
       "src",
       "build/generated",
       "../text-console",
       "../../library/rose",
       "../../library/drawing");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("surface_console-driver.adb");

   package Builder is
      for Global_Configuration_Pragmas use "pragmas.config";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
      for Executable ("surface_console-driver.adb") use "surface-console";
   end Builder;

   --  -gnatw.X: the generated user-mode packages raise exceptions, which
   --  go to the last-chance handler until the run-time system propagates
   --  them (#170). GNAT warns about each such raise.

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-gnatwael", "-gnatw.X", "-gnatVa", "-gnatyabcefhiklmnoprst", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib") & Checks.Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end Surface_Console;
