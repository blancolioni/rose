with "../../../projects/checks.gpr";

project Clock is

   --  Built with the userland run-time system and the user-mode IDL
   --  target (#367), whose packages the Makefile generates in
   --  build/generated. The run-time system has Rose's base, capability
   --  and system call packages.

   for Source_Dirs use
      ("src",
       "build/generated",
       "../../library/kernelapi/devices");
   for Source_Files use
      ("clock.ads",
       "clock-calendar.ads",
       "clock-calendar.adb",
       "clock-driver.adb",
       "clock-rtc.ads",
       "clock-rtc.adb",
       "clock-server.ads",
       "clock-server.adb",
       "rose-devices.ads",
       "rose-devices-port_io.ads",
       "rose-devices-port_io.adb",
       "rose-interfaces-clock.ads",
       "rose-interfaces-clock-server.ads",
       "rose-interfaces-clock-server.adb",
       "rose-interfaces-clock_admin.ads",
       "rose-interfaces-clock_admin-server.ads",
       "rose-interfaces-clock_admin-server.adb",
       "rose-interfaces-restorable.ads",
       "rose-interfaces-restorable-server.ads",
       "rose-interfaces-restorable-server.adb");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("clock-driver.adb");

   package Builder is
      for Global_Configuration_Pragmas use "pragmas.config";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
      for Executable ("clock-driver.adb") use "clock";
   end Builder;

   --  -gnatw.X: the generated user-mode packages raise exceptions, which
   --  go to the last-chance handler until the run-time system propagates
   --  them (#170). GNAT warns about each such raise.

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-gnatwael", "-gnatw.X", "-gnatVa", "-gnatyabcefhiklmnoprst", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib") & Checks.Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end Clock;
