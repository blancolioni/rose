project Exec is

   --  Built with the userland run-time system (#490), which has Rose's
   --  base, capability and system call packages.

   --  The RTS's own interface specs come first, so that the program
   --  uses them and not the other copies on its path (#538).

   for Source_Dirs use
      ("../../rts/build/interfaces",
       "src",
       "../../library/kernelapi/console",
       "../../library/rose",
       "../../library/kernelapi/generated");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("exec-driver.adb");

   package Builder is
      for Global_Configuration_Pragmas use "exec-pragmas.config";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../rts/build/i686-rose");
      for Executable ("exec-driver.adb") use "exec";
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-gnatVa", "-gnatwael", "-gnatyM79abcefhiklnoprst", "-g", "-gnato", "-gnatp", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib");
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../rts/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end Exec;
