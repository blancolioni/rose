with "../../../projects/checks.gpr";
with "../../../rts/user/rose_rts.gpr";

project vga_console is

   --  Built with the userland run-time system and the user-mode IDL
   --  target (#367), whose packages the Makefile generates in
   --  build/generated. The run-time system has Rose's base, capability
   --  and system call packages.

   --  The RTS's own units, its interface specs among them, come from
   --  rose_rts.gpr (#1080).

   for Source_Dirs use
      ("src",
       "build/generated",
       "../text-console",
       "../../library/rose",
       "../../library/kernelapi/devices");
   for Source_Files use
      ("vga_console.ads",
       "vga_console-driver.adb",
       "vga_console-line_discipline.ads",
       "text_console.ads",
       "text_console-cells.ads",
       "text_console-cells.adb",
       "text_console-line_discipline.ads",
       "text_console-line_discipline.adb",
       "text_console-serial.ads",
       "text_console-serial.adb",
       "vga_console-screen.ads",
       "vga_console-screen.adb",
       "vga_console-server.ads",
       "vga_console-server.adb",
       "rose-keys.ads",
       "rose-devices.ads",
       "rose-devices-port_io.ads",
       "rose-devices-port_io.adb",
       "rose-interfaces-devices.ads",
       "rose-interfaces-devices-event_listener.ads",
       "rose-interfaces-devices-event_listener-server.ads",
       "rose-interfaces-devices-event_listener-server.adb",
       "rose-interfaces-devices-event_source.ads",
       "rose-interfaces-devices-event_source-client.ads",
       "rose-interfaces-devices-event_source-client.adb",
       "rose-interfaces-processes-restorable-server.ads",
       "rose-interfaces-processes-restorable-server.adb",
       "rose-interfaces-streams-stream.ads",
       "rose-interfaces-screens.ads",
       "rose-interfaces-screens-terminal.ads",
       "rose-interfaces-screens-terminal-server.ads",
       "rose-interfaces-screens-terminal-server.adb");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("vga_console-driver.adb");

   package Builder is
      for Global_Configuration_Pragmas use "pragmas.config";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
      for Executable ("vga_console-driver.adb") use "vga-console";
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-gnatwael", "-gnatVa", "-gnatyabcefhiklmnoprst", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib") & Checks.Switches
        & Checks.Optimisation_Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end vga_console;
