with "../../../projects/checks.gpr";

project vga_console is

   --  Built with the userland run-time system and the user-mode IDL
   --  target (#367), whose packages the Makefile generates in
   --  build/generated. The run-time system has Rose's base, capability
   --  and system call packages.

   --  The RTS's own interface specs come first, so that the program
   --  uses them and not the other copies on its path (#538).

   for Source_Dirs use
      ("../../../rts/user/build/interfaces",
       "src",
       "build/generated",
       "../../library/kernelapi/devices");
   for Source_Files use
      ("vga_console.ads",
       "vga_console-driver.adb",
       "vga_console-line_discipline.ads",
       "vga_console-line_discipline.adb",
       "vga_console-screen.ads",
       "vga_console-screen.adb",
       "vga_console-server.ads",
       "vga_console-server.adb",
       "rose-devices.ads",
       "rose-devices-port_io.ads",
       "rose-devices-port_io.adb",
       "rose-interfaces-event_listener.ads",
       "rose-interfaces-event_listener-server.ads",
       "rose-interfaces-event_listener-server.adb",
       "rose-interfaces-event_source.ads",
       "rose-interfaces-event_source-client.ads",
       "rose-interfaces-event_source-client.adb",
       "rose-interfaces-restorable.ads",
       "rose-interfaces-restorable-server.ads",
       "rose-interfaces-restorable-server.adb",
       "rose-interfaces-stream.ads",
       "rose-interfaces-stream_reader.ads",
       "rose-interfaces-stream_writer.ads",
       "rose-interfaces-terminal.ads",
       "rose-interfaces-terminal-server.ads",
       "rose-interfaces-terminal-server.adb");
   for Object_Dir use "./build/obj";
   for Exec_Dir use "./build/bin";
   for Main use ("vga_console-driver.adb");

   package Builder is
      for Global_Configuration_Pragmas use "pragmas.config";
      for Default_Switches ("ada") use ("-s", "-k", "-g", "-O3", "-C", "-j2", "--RTS=../../../rts/user/build/i686-rose");
      for Executable ("vga_console-driver.adb") use "vga-console";
   end Builder;

   --  -gnatw.X: the generated user-mode packages raise exceptions, which
   --  go to the last-chance handler until the run-time system propagates
   --  them (#170). GNAT warns about each such raise.

   package Compiler is
      for Default_Switches ("ada") use ("-g", "-gnatwael", "-gnatw.X", "-gnatVa", "-gnatyabcefhiklmnoprst", "-m32", "-gnat12", "-fno-strict-aliasing", "-nostdlib") & Checks.Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

   package Linker is
      for Default_Switches ("ada") use ("-m32", "-Wl,-T../../linker.ld", "-ffreestanding", "-nostdlib", "../../../rts/user/start/start.o");
   end Linker;

   package Pretty_Printer is
      for Default_Switches ("ada") use ("-M72");
   end Pretty_Printer;

end vga_console;
